rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /chatThreads/{threadId} {
      allow read: if request.auth != null
                   && request.auth.uid in resource.data.participantUids;
      allow create: if request.auth != null
                     && request.auth.uid in request.resource.data.participantUids;
      allow update: if request.auth != null
                     && request.auth.uid in resource.data.participantUids;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
                     && request.auth.uid in
                        get(/databases/$(database)/documents/chatThreads/$(threadId)).data.participantUids;
        allow create: if request.auth != null
                       && request.auth.uid in
                          get(/databases/$(database)/documents/chatThreads/$(threadId)).data.participantUids
                       && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /statusStories/{ownerUid} {
      // Any signed-in user can read any status story (like a real Status
      // feature) -- only the owner (document id == their own uid) can
      // write it.
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == ownerUid;
    }
  }
}