rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /chatThreads/{threadId} {
      allow read: if request.auth != null
                   && request.auth.uid in resource.data.participantUids;
      allow create: if request.auth != null
                     && request.auth.uid in request.resource.data.participantUids;
      allow update: if request.auth != null
                     && request.auth.uid in resource.data.participantUids;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
                     && request.auth.uid in
                        get(/databases/$(database)/documents/chatThreads/$(threadId)).data.participantUids;
        allow create: if request.auth != null
                       && request.auth.uid in
                          get(/databases/$(database)/documents/chatThreads/$(threadId)).data.participantUids
                       && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /statusStories/{ownerUid} {
      // Any signed-in user can read any status story (like a real Status
      // feature) -- only the owner (document id == their own uid) can
      // write it.
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == ownerUid;
    }

    match /communities/{communityId} {
      // Membership-gated, like a real private group: only uids in
      // memberUids can read the document at all. Only the owner can write
      // it -- including adding members -- so joining today only happens
      // via the owner inviting someone (no self-service join/invite-link
      // flow yet). A new community must start with only its own creator as
      // a member.
      allow read: if request.auth != null
                    && request.auth.uid in resource.data.memberUids;
      allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.ownerUid
                      && request.resource.data.memberUids == [request.auth.uid];
      allow update: if request.auth != null
                      && request.auth.uid == resource.data.ownerUid;
      allow delete: if false;
    }

    match /phoneDirectory/{phoneKey} {
      // Any signed-in user can check whether a phone number is registered
      // (needed for device-contact matching) -- but can only create/claim
      // an entry for their OWN uid, and can't overwrite someone else's
      // mapping. Deliberately approximate: phoneKey is a trailing-digits
      // match key, not a real E.164 phone number (see
      // core/utils/phone_number_matching.dart).
      allow read: if request.auth != null;
      allow create: if request.auth != null
                      && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                      && request.auth.uid == resource.data.uid
                      && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /pushTokens/{ownerUid} {
      // Only the owner can read/write their own push token -- a future
      // server-side sender would use the Admin SDK, which bypasses these
      // rules entirely, so no client ever needs cross-user read access.
      allow read, write: if request.auth != null && request.auth.uid == ownerUid;
    }

    match /calls/{callId} {
      // Only the two participants can ever read a call doc. Only the
      // caller can create one (the callee doesn't need write access to be
      // invited). Either side can update status (accept/decline/end), but
      // can't change who's on the call or which room it points to --
      // those fields are fixed at creation.
      allow read: if request.auth != null
                    && (request.auth.uid == resource.data.callerUid
                        || request.auth.uid == resource.data.calleeUid);
      allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.callerUid;
      allow update: if request.auth != null
                      && (request.auth.uid == resource.data.callerUid
                          || request.auth.uid == resource.data.calleeUid)
                      && request.resource.data.callerUid == resource.data.callerUid
                      && request.resource.data.calleeUid == resource.data.calleeUid
                      && request.resource.data.roomName == resource.data.roomName;
      allow delete: if false;
    }
  }
}