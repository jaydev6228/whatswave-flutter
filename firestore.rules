rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /chatThreads/{threadId} {
      // The !exists() branch lets startThread() check "does this thread
      // already exist" before creating one (deterministic sorted-uid id,
      // see FirestoreChatRepository.startThread) -- without it, reading a
      // not-yet-created thread errors on resource.data being null and gets
      // denied outright, blocking the very first message between two
      // people. A non-existent doc has nothing to expose either way.
      allow read: if request.auth != null
                   && (!exists(/databases/$(database)/documents/chatThreads/$(threadId))
                       || request.auth.uid in resource.data.participantUids);
      allow create: if request.auth != null
                     && request.auth.uid in request.resource.data.participantUids;
      allow update: if request.auth != null
                     && request.auth.uid in resource.data.participantUids;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
                     && request.auth.uid in
                        get(/databases/$(database)/documents/chatThreads/$(threadId)).data.participantUids;
        allow create: if request.auth != null
                       && request.auth.uid in
                          get(/databases/$(database)/documents/chatThreads/$(threadId)).data.participantUids
                       && request.resource.data.senderUid == request.auth.uid;
        // Reactions -- a participant may only touch the reactions map, and
        // only their own uid's entry within it (see
        // FirestoreChatRepository.toggleMessageReaction).
        allow update: if request.auth != null
                       && request.auth.uid in
                          get(/databases/$(database)/documents/chatThreads/$(threadId)).data.participantUids
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
                       && request.resource.data.reactions.diff(
                            resource.data.get('reactions', {})
                          ).affectedKeys().hasOnly([request.auth.uid]);

        // Edit -- only the original sender, only the text itself (plus the
        // isEdited flag it must set alongside it). See
        // FirestoreChatRepository.editMessage.
        allow update: if request.auth != null
                       && request.auth.uid == resource.data.senderUid
                       && request.resource.data.diff(resource.data)
                            .affectedKeys().hasOnly(['text', 'isEdited'])
                       && request.resource.data.isEdited == true;

        // Delete for everyone -- only the original sender, clearing the
        // content and marking isDeleted so every participant renders the
        // same "This message was deleted" placeholder. See
        // FirestoreChatRepository.deleteMessage.
        allow update: if request.auth != null
                       && request.auth.uid == resource.data.senderUid
                       && request.resource.data.diff(resource.data)
                            .affectedKeys().hasOnly(['text', 'attachments', 'isDeleted'])
                       && request.resource.data.isDeleted == true
                       && request.resource.data.text == ''
                       && request.resource.data.attachments == [];

        // Delete for me -- any participant may add (never remove) their
        // own uid to hiddenFor; everyone else still sees the message
        // untouched. See FirestoreChatRepository.deleteMessage /
        // _messageFromDoc's hiddenFor filter.
        allow update: if request.auth != null
                       && request.auth.uid in
                          get(/databases/$(database)/documents/chatThreads/$(threadId)).data.participantUids
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor'])
                       && request.resource.data.hiddenFor.hasAll(resource.data.get('hiddenFor', []))
                       && request.resource.data.hiddenFor.hasOnly(
                            resource.data.get('hiddenFor', []).concat([request.auth.uid])
                          );
        allow delete: if false;
      }
    }

    match /statusStories/{ownerUid} {
      // A story is only visible to its owner or someone who has chatted
      // with them at least once -- checked via exists() against the same
      // deterministic sorted-uid chatThreads id
      // FirestoreChatRepository.startThread uses, since Firestore can't
      // filter a collection-wide query by this rule (the repository reads
      // each visible story individually instead of scanning the whole
      // collection; see FirestoreUpdatesRepository's class doc comment).
      // Only the owner (document id == their own uid) can write it.
      allow read: if request.auth != null
                    && (request.auth.uid == ownerUid
                        || exists(/databases/$(database)/documents/chatThreads/$(
                             request.auth.uid < ownerUid
                               ? request.auth.uid + '_' + ownerUid
                               : ownerUid + '_' + request.auth.uid
                           )));
      allow write: if request.auth != null && request.auth.uid == ownerUid;

      match /views/{viewerUid} {
        // Per-viewer seen-progress. The story doc above is owner-write-only,
        // so a viewer's "how far have I watched" state can't live there --
        // it never actually persisted for anyone but the owner, which is
        // why seen state reverted after the app restarted and re-read the
        // untouched story doc. Each viewer's own progress lives in their
        // own doc here instead, readable and writable only by that viewer.
        allow get, write: if request.auth != null
                             && request.auth.uid == viewerUid;
        // The owner may list/count this subcollection -- that's how
        // FirestoreUpdatesRepository shows "N views" on their own story
        // (a count() aggregate query needs the same `list` permission a
        // regular list query would). Real WhatsApp shows the owner exactly
        // who viewed, so exposing viewerUids here to the owner isn't a
        // narrower privacy bar than the feature this is building toward.
        allow list: if request.auth != null && request.auth.uid == ownerUid;
      }
    }

    match /communities/{communityId} {
      // Membership-gated, like a real private group: only uids in
      // memberUids can read the document at all. Only the owner can write
      // it -- including adding members -- so joining today only happens
      // via the owner inviting someone (no self-service join/invite-link
      // flow yet). A new community must start with only its own creator as
      // a member.
      allow read: if request.auth != null
                    && request.auth.uid in resource.data.memberUids;
      allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.ownerUid
                      && request.resource.data.memberUids == [request.auth.uid];
      allow update: if request.auth != null
                      && request.auth.uid == resource.data.ownerUid;
      // Unlike chatThreads' soft "hide for me" delete, deleting a community
      // is meant to remove it for everyone (there's no other participant's
      // separate view to preserve the way a 1:1 chat has) -- a real delete,
      // restricted to the owner, matching callHistory's owner-scoped
      // delete below.
      allow delete: if request.auth != null
                      && request.auth.uid == resource.data.ownerUid;
    }

    match /phoneDirectory/{phoneKey} {
      // Any signed-in user can check whether a phone number is registered
      // (needed for device-contact matching) -- but can only create/claim
      // an entry for their OWN uid, and can't overwrite someone else's
      // mapping. Deliberately approximate: phoneKey is a trailing-digits
      // match key, not a real E.164 phone number (see
      // core/utils/phone_number_matching.dart).
      allow read: if request.auth != null;
      allow create: if request.auth != null
                      && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                      && request.auth.uid == resource.data.uid
                      && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /userProfiles/{uid} {
      // Any signed-in user can look up another user's public display
      // name/avatar/color -- e.g. FirestoreChatRepository uses this so
      // each side of a 1:1 chat shows the *other* person's real name,
      // instead of whatever got baked into the thread doc once by
      // whoever created it. Only the owner can write their own profile.
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /pushTokens/{ownerUid} {
      // Only the owner can read/write their own push token -- a future
      // server-side sender would use the Admin SDK, which bypasses these
      // rules entirely, so no client ever needs cross-user read access.
      allow read, write: if request.auth != null && request.auth.uid == ownerUid;
    }

    match /calls/{callId} {
      // Only the two participants can ever read a call doc. Only the
      // caller can create one (the callee doesn't need write access to be
      // invited), and callerUid/calleeUid must differ -- self-calls were
      // briefly allowed to smoke-test the debug call-signaling screen on
      // one device, now reverted since real calling is wired up and
      // self-calls have no legitimate use. Either side can update status
      // (accept/decline/end), but can't change who's on the call, which
      // room it points to, or the caller identity stamped at creation
      // (callerName/callerAvatarLabel/callerAccentColorArgb, see
      // FirestoreCallSignalingService.placeCall) -- those fields are all
      // fixed at creation.
      allow read: if request.auth != null
                    && (request.auth.uid == resource.data.callerUid
                        || request.auth.uid == resource.data.calleeUid);
      allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.callerUid
                      && request.resource.data.callerUid
                          != request.resource.data.calleeUid;
      allow update: if request.auth != null
                      && (request.auth.uid == resource.data.callerUid
                          || request.auth.uid == resource.data.calleeUid)
                      && request.resource.data.callerUid == resource.data.callerUid
                      && request.resource.data.calleeUid == resource.data.calleeUid
                      && request.resource.data.roomName == resource.data.roomName
                      && request.resource.data.get('callerName', null)
                          == resource.data.get('callerName', null)
                      && request.resource.data.get('callerAvatarLabel', null)
                          == resource.data.get('callerAvatarLabel', null)
                      && request.resource.data.get('callerAccentColorArgb', null)
                          == resource.data.get('callerAccentColorArgb', null);
      allow delete: if false;
    }

    match /callHistory/{entryId} {
      // A personal call log, one entry per side of a call (see
      // FirestoreCallsRepository) -- ownerUid must always match the
      // signed-in caller, so nobody can read, write, or enumerate anyone
      // else's history. Unlike chatThreads/phoneDirectory (which
      // deliberately never hard-delete -- `allow delete: if false` and a
      // soft-delete pattern instead, e.g. chatThreads' hiddenFor array), a
      // real delete is allowed here: clearing call history removes only
      // the owner's own private data, with no other participant's view of
      // anything at risk the way there would be for a shared chat thread.
      // (communities allows a real owner-scoped delete too, for the same
      // "meant to be gone for everyone, by the owner" reason -- see that
      // match block above.)
      allow read: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid;
      allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.ownerUid;
      allow update: if request.auth != null
                      && request.auth.uid == resource.data.ownerUid;
      allow delete: if request.auth != null
                      && request.auth.uid == resource.data.ownerUid;
    }
  }
}