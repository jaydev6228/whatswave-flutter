rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Upload ceilings. Without these, any signed-in user can write an
    // object of any size to any writable path -- a cheap way to run up a
    // Storage bill or fill a bucket, and nothing in the app needs it.
    //
    // Sized per use: a chat attachment may legitimately be a long video,
    // while an avatar or group icon is a cropped square and has no business
    // being larger than a few MB.
    function withinSize(maxBytes) {
      return request.resource.size <= maxBytes;
    }
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // Chat photo/video attachments, uploaded by FirestoreChatRepository at
    // chatMedia/{threadId}/{messageId}-{attachmentId}.{ext} -- readable by
    // anyone signed in (Storage rules can't cheaply express "any CURRENT
    // participant of this specific thread" the way firestore.rules does for
    // the thread doc itself, and a downloadURL's random token already keeps
    // it unguessable/unlistable to anyone who wasn't sent it -- the same
    // trust model most apps use for shared-media links). Only the uploader
    // (the request's own signed-in user) can write; nothing can overwrite
    // or delete another user's upload -- messages don't support editing.
    //
    // Size-capped but deliberately NOT content-type restricted: sending an
    // arbitrary document (Word/Excel/PowerPoint/PDF, via file_picker) is a
    // feature, so there is no meaningful allowlist to write here. Note for
    // later: once attachments are encrypted before upload they arrive as
    // application/octet-stream, so adding a content-type allowlist here
    // would break that -- the size cap is the durable control.
    match /chatMedia/{threadId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && withinSize(100 * 1024 * 1024);
      allow delete: if false;
    }

    // Status/story media, uploaded by FirebaseStatusMediaStore at
    // statusMedia/{uid}/{fileName} -- same "signed-in + unguessable URL"
    // model as chatMedia above; the story DOCUMENT's own visibility (owner
    // or a past chat partner only) is enforced in firestore.rules, which is
    // the actual privacy boundary users interact with. Only the owner uid
    // can write or delete their own status media (matches
    // FirebaseStatusMediaStore.deleteMedia's cleanup on expiry/deletion).
    match /statusMedia/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && withinSize(50 * 1024 * 1024)
        && (isImage() || request.resource.contentType.matches('video/.*'));
    }

    // Profile photos at profilePhotos/{uid}/{fileName} -- public-read to
    // any signed-in user, mirroring userProfiles/{uid} in firestore.rules
    // (any signed-in user can already look up another user's name/avatar).
    // Only the owner uid can write or delete their own photo.
    match /profilePhotos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && withinSize(8 * 1024 * 1024) && isImage();
    }

    // Group icons at groupPhotos/{threadId}/{fileName} -- uploaded by
    // FirestoreChatRepository.updateGroupAvatar. Readable by any signed-in
    // user (same unguessable-URL model as chatMedia); writable only by a
    // group admin, checked against chatThreads/{threadId}.groupAdminUids in
    // Firestore (mirrors firestore.rules' groupAvatarUrl update rule).
    match /groupPhotos/{threadId}/{fileName} {
      function isThreadAdmin() {
        return request.auth.uid in firestore.get(/databases/(default)/documents/chatThreads/$(threadId)).data.get('groupAdminUids', []);
      }
      allow read: if request.auth != null;
      allow delete: if request.auth != null && isThreadAdmin();
      allow write: if request.auth != null && isThreadAdmin()
        && withinSize(8 * 1024 * 1024) && isImage();
    }

    // Community icons at communityPhotos/{communityId}/{fileName} --
    // uploaded by FirestoreCommunitiesRepository.updateCommunityAvatar.
    // Same admin gate as firestore.rules: owner counts even when adminUids
    // is missing on a community created before that roster existed.
    match /communityPhotos/{communityId}/{fileName} {
      function communityData() {
        return firestore.get(/databases/(default)/documents/communities/$(communityId)).data;
      }
      function isCommunityAdmin() {
        return request.auth.uid == communityData().ownerUid
            || request.auth.uid in communityData().get('adminUids', []);
      }
      allow read: if request.auth != null;
      allow delete: if request.auth != null && isCommunityAdmin();
      allow write: if request.auth != null && isCommunityAdmin()
        && withinSize(8 * 1024 * 1024) && isImage();
    }

    // "Add music" catalog audio at statusMusic/{fileName} -- admin-uploaded
    // (see the seeding script referenced by statusMusicTracks in
    // firestore.rules), never written from the client. Readable by any
    // signed-in user, same as every other shared-catalog asset above.
    match /statusMusic/{fileName} {
      allow read: if request.auth != null;
      allow write, delete: if false;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
